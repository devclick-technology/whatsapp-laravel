{
    "name": "devclick/whatsapp-laravel",
    "description": "Text-only Laravel integration for the shared Node WhatsApp service.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*",
        "laravel/framework": "^12.0 || ^13.0",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "DevClick\\WhatsApp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DevClick\\WhatsApp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DevClick\\WhatsApp\\WhatsAppServiceProvider"
            ],
            "aliases": {
                "WhatsApp": "DevClick\\WhatsApp\\Facades\\WhatsApp"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "check": "pint --test"
    },
    "config": {
        "sort-packages": true
    }
}
